# Our deployment settings, layered over upstream's config.example.env by
# scripts/render.py. Only list values that differ from upstream's defaults.
#
# APP_TAG is the OneUptime version: render.py checks out the upstream git tag
# of the same name, and the images default to it. Upgrading = bump it, re-render.
APP_TAG=14.0.107

# Coolify's Traefik terminates TLS; OneUptime's ingress sits behind it.
HTTP_PROTOCOL=https
PROVISION_SSL=false
# Traefik -> ingress. Use 3 if Cloudflare also proxies.
TRUSTED_PROXY_HOPS=2

# HOST stays a Coolify variable (see render.py); these derive from it.
STATUS_PAGE_CNAME_RECORD=${HOST}
DASHBOARD_CNAME_RECORD=${HOST}
# The probe runs on the host network and can't resolve compose service names.
GLOBAL_PROBE_1_ONEUPTIME_URL=https://${HOST}

# Backups (backups.yml). Both stay Coolify variables with these defaults; the
# restore-drill resource overrides both so it can't touch production's backups.
BACKUP_PREFIX=oneuptime
BACKUP_SCOPE=oneuptime
